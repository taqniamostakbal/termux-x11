<?xml version="1.0" encoding="utf-8"?>
<!-- Mudif mouse bar, v3 (p58). ONE mouse body seen from above, wide oval:
     left half of the front is left click, the scroll wheel sits on the
     center line, right half of the front is right click. The three
     ImageButtons over it are transparent zones; their pressed state
     (mouse_buttons.xml, semi-transparent purple) lights the zone without
     hiding the white outline or the wheel.
     Viewport 164x56 matches the compact container exactly (three 48dp
     buttons plus 2dp margins plus 4dp padding: 164 wide, 56 tall), so the
     vector background is not stretched. The v2 body was 188x60 and the
     gear tap stretched it to ~268dp wide; the flip is gone in p58, so
     there is no vertical twin anymore (ic_mouse_body_vertical.xml is
     deleted by this patch). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="164dp"
    android:height="56dp"
    android:viewportWidth="164"
    android:viewportHeight="56">
    <!-- Body: wide oval, glass black 70 percent, white edge at 45 percent
         (strong enough to read as a mouse body over any wallpaper). -->
    <path
        android:fillColor="#B3000000"
        android:strokeColor="#73FFFFFF"
        android:strokeWidth="1.5"
        android:pathData="M30,4 H134 C150,4 160,15 160,28 C160,41 150,52 134,52 H30 C14,52 4,41 4,28 C4,15 14,4 30,4 Z" />
    <!-- Center split: left and right button divider, nose to wheel. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeAlpha="0.7"
        android:pathData="M82,4 V30" />
    <!-- Scroll wheel: white rounded rect on the center line. -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.95"
        android:pathData="M77,8 h10 a5,5 0,0 1 5,5 v2 a5,5 0,0 1 -5,5 h-10 a5,5 0,0 1 -5,-5 v-2 a5,5 0,0 1 5,-5 Z" />
    <!-- Wheel grip: one dark line across the wheel. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#B3000000"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M77,14 H87" />
</vector>
