<?xml version="1.0" encoding="utf-8"?>
<!-- Mudif mouse button zone (v2, p62: the mouse-body background is
     gone, the bar is a plain dark pill): the three ImageButtons are
     transparent by default (the pill behind shows through, with the
     L/M/R mouse icons on top), and while pressed the zone lights
     Mudif purple #593BFE at 55 percent. Rounded 12dp.
     Selected state is used by the stylus cluster (mode indicator). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#8C593BFE" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#8C593BFE" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
